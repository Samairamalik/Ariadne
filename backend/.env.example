# Copy to .env (same folder you start the backend from). Never commit .env.
# Keys only: switch offline/cloud with `python switch_llm.py offline|cloud` (the saved choice in
# data/llm_settings.json overrides ARIADNE_LLM_MODE once it exists).
ARIADNE_GROQ_API_KEY=
ARIADNE_GEMINI_API_KEY=
